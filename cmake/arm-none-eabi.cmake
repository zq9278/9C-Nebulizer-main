set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(DEFINED ENV{STM32_GCC_PATH})
  file(TO_CMAKE_PATH "$ENV{STM32_GCC_PATH}" STM32_GCC_HINT)
endif()
find_program(CMAKE_C_COMPILER arm-none-eabi-gcc HINTS "${STM32_GCC_HINT}" REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
get_filename_component(GCC_BIN "${CMAKE_C_COMPILER}" DIRECTORY)
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${GCC_BIN}" REQUIRED)
find_program(CMAKE_SIZE arm-none-eabi-size HINTS "${GCC_BIN}" REQUIRED)
