#!/bin/sh /etc/rc.common
START=78
STOP=12
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/slk-mender-tls-relay --mode transparent --listen 127.0.0.1:18443 --upstream 47.111.69.184:18443 --fragment-delay 50ms
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
